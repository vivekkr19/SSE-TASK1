class Solution {
public:
    vector<int> findClosestElements(vector<int>& arr, int k, int x) {
      int n= arr.size();
      long long lo=0;
      long long high=n-1;
      bool found = false;
      int t=0;
      vector<int>v(k);
      long long mid;

      if(x<arr[0]){
        for(int i=0;i<k;i++){
            v[t]=arr[i];
            t++;
        }
        return v;
      }
      if(x>arr[n-1]){
        for(int i=n-1;i>=n-k;i--){
            v[t]=arr[i];
            t++;
        }
        sort(v.begin(), v.end());
        return v;
      }
      
    while(lo<=high){
         mid= lo+(high-lo)/2;
         if(arr[mid] == x){
         found = true;
         v[t]=x;
         t++;
         break;
         
         }
         else if(arr[mid]<x) lo=mid+1;
         else high=mid+1;
    }

    int lb=high;
    int ub=lo;
    if(found == true){
        lb=mid-1;
        ub=mid+1;
    }
    while(t<k){
        int d1=abs(x-arr[lb]);
         int d2=abs(x-arr[ub]);
         if(lb<0){
            v[t]=ub;
            ub++;
         }
         else if(ub>n-1){
            v[t]=lb;
            lb--;
         }
         else if(d1<=d2){
            v[t]=arr[lb];
            lb--;
         }
         else if(d1>d2){
            v[t]=arr[ub];
            ub++;
         }


    }
     return v;


    }
}